{
    "name": "obsidian-shortcuts-for-starred-files",
    "version": "1.1.1",
    "description": "Set an individual hotkey for the first 9 bookmarks and open them just with your keyboard.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs dev",
        "build": "pnpm run tsc && node esbuild.config.mjs production",
        "tsc": "tsc --noEmit",
        "release": "commit-and-tag-version"
    },
    "keywords": [],
    "author": "Vinzent03",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^26.6.6",
        "commit-and-tag-version": "^13.3.0",
        "esbuild": "^0.28.2",
        "obsidian": "^1.14.4",
        "typescript": "5.9.3"
    },
    "type": "module",
    "commit-and-tag-version": {
        "t": "",
        "bumpFiles": [
            "package.json",
            "manifest.json",
            {
                "filename": "versions.json",
                "updater": "./version-bump.cjs"
            }
        ]
    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=11"
    },
    "packageManager": "pnpm@12.9.0"
}
